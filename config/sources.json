      "github": 0.9,
      "hackernews": 1.0,
      "paper": 0.95,
      "youtube": 0.9,
      "blog": 0.85
    },
    "hot_keywords": [
      "agent harness", "harness", "coding agent", "claude code", "codex", "mcp",
      "tool use", "tool calling", "context engineering", "agentic", "multi-agent",
      "computer use", "browser use", "sandbox", "eval", "benchmark"
