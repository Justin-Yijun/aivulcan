    "hot_boost": 1.35,
    "interview_keywords": [
      "system design", "how to build", "from scratch", "internals",
      "implementation", "deep dive", "design a"
    ],
    "interview_boost": 1.5,
    "recency_factor": { "1": 1.0, "3": 0.95, "7": 0.9, "30": 0.85, "9999": 0.6 }
  },

  "output": {
